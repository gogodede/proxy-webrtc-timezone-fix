{
  "manifest_version": 3,
  "name": "Proxy WebRTC Timezone fix",
  "description": "Proxy management, WebRTC leak control and timezone spoofing in one extension.",
  "version": "1.0.0",
  "default_locale": "en",
  "author": "gogodede",
  "icons": {
    "16": "image/icon.png",
    "32": "image/icon32.png",
    "48": "image/icon48.png",
    "64": "image/icon64.png",
    "128": "image/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "image/icon.png",
      "32": "image/icon32.png"
    },
    "default_popup": "content/popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "content/options.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "notifications",
    "proxy",
    "storage",
    "tabs",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "browsingData"
  ],
  "commands": {
    "proxyByPatterns": {
      "description": "__MSG_proxyByPatterns__"
    },
    "disable": {
      "description": "__MSG_disable__"
    },
    "setProxy": {
      "description": "__MSG_setProxy__"
    },
    "includeHost": {
      "description": "__MSG_includeHost__"
    },
    "excludeHost": {
      "description": "__MSG_excludeHost__"
    },
    "setTabProxy": {
      "description": "__MSG_setTabProxy__"
    },
    "unsetTabProxy": {
      "description": "__MSG_unsetTabProxy__"
    }
  },
  "storage": {
    "managed_schema": "content/schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "minimum_chrome_version": "126",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "privacy/page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "privacy/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
